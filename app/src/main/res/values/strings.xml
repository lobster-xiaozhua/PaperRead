    <!-- 朗读通知权限场景化（T-009 · R-02 / AC-20.1）：首次朗读前场景化说明，
         确认后才发起系统 POST_NOTIFICATIONS 申请；拒绝不影响朗读。 -->
    <string name="speech_permission_prompt_title">朗读控制通知</string>
    <string name="speech_permission_prompt_message">纸阅申请通知权限，用于在通知栏显示朗读控制（播放 / 暂停 / 上一段 / 下一段 / 停止），方便你在锁屏或其他应用界面控制朗读。拒绝不影响朗读，仅通知栏控制不可用。</string>
    <string name="speech_permission_prompt_confirm">同意并继续</string>
    <string name="speech_permission_prompt_dismiss">暂不</string>

    <!-- 隐私说明一页（T-009 · R-02 / AC-20.3 / AC-20.4） -->
    <string name="privacy_title">隐私说明</string>
    <string name="privacy_intro">纸阅把「数据不出本机」作为硬约束。本页列明应用申请的每一项权限及其用途、网络行为边界，以及备份与诊断导出的数据边界，内容与应用实际合并的 Manifest 一致。</string>
    <string name="privacy_section_permissions">权限清单</string>
    <string name="privacy_section_no_public_network">网络行为</string>
    <string name="privacy_section_data_boundary">备份加密与诊断导出的数据边界</string>
    <string name="privacy_permission_internet_name">android.permission.INTERNET</string>
    <string name="privacy_permission_internet_purpose">用于同一局域网内的设备发现与书籍传输（传书 / 换机迁移 / 进度同步）。Android 没有「仅局域网」权限，任何 socket 都必须声明它；HTTP 服务仅绑定 WiFi 网卡地址，不访问互联网。</string>
    <string name="privacy_permission_foreground_service_name">android.permission.FOREGROUND_SERVICE</string>
    <string name="privacy_permission_foreground_service_purpose">朗读退到后台或锁屏时，以前台服务方式保持播放不中断。</string>
    <string name="privacy_permission_foreground_service_media_playback_name">android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK</string>
    <string name="privacy_permission_foreground_service_media_playback_purpose">Android 14+ 对 mediaPlayback 类型前台服务的强制权限；低版本系统上不存在该权限，声明无害。</string>
    <string name="privacy_permission_post_notifications_name">android.permission.POST_NOTIFICATIONS</string>
    <string name="privacy_permission_post_notifications_purpose">Android 13+ 运行时权限，仅用于显示朗读控制通知。申请时机为首次朗读前的场景化说明（对话框告知用途后由你确认），不在应用启动时批量申请；拒绝后朗读仍可播放，仅通知栏控制不可用。</string>
    <string name="privacy_no_public_network_body">纸阅不访问公网：传书 / 迁移 / 同步只在你自己的局域网内进行；书源解析、章节切分、朗读合成（系统 TTS 引擎）全部在本机完成；应用不内置任何远程接口调用、不加载远程资源、不上传任何数据。</string>
    <string name="privacy_data_boundary_body">本地备份：备份文件由你选择存放位置（系统文件选择器），可选加密（条目级 AES-256-GCM），密钥由你设置，纸阅不保存、不传输。\n诊断导出：导出的诊断包仅包含应用版本、设备型号、错误堆栈与脱敏后的书架统计，不含书籍正文、不含个人信息。\n云备份边界：系统云备份（allowBackup）仅包含数据库与设置，刻意排除书籍正文文件。</string>

