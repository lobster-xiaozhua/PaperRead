<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 及以下（API ≤ 31）的备份规则（fullBackupContent）。
  Android 12+ 使用 data_extraction_rules.xml，本文件被忽略；minSdk 26 故两者都要。

  B5 方案甲-B：
  - 排除 files/books/（source.txt + book.txt，单本数百 MB）：
    Auto Backup 单应用云配额仅 25 MB，书籍入库后备份必然超限失败，
    且书籍内容属于最敏感的本地数据，不应上 Google 云
  - 保留其余全部（sharedpref 阅读设置 + Room 数据库）：
    重装应用可恢复书架结构、进度与书签
-->
<full-backup-content>
    <exclude domain="file" path="books" />
</full-backup-content>
