<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      权限策略（2026-10-18 用户拍板，ROADMAP C9 决策点 2）：允许申请权限，
      保持最小权限。本应用唯一声明项：INTERNET。

      技术事实：Android 上任何 socket（包括连接局域网 IP）都必须声明 INTERNET，
      系统没有「仅局域网」权限。传书 / 换机迁移 / 进度同步均只在同一局域网内
      进行（HTTP 服务仅绑定 WiFi 网卡地址，不监听其他接口），不访问公网、
      不收集、不上传任何个人信息。新增任何其他权限都需在 PR 中说明理由
      （见 AGENTS.md）。
    -->

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".PaperReadApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PaperRead">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          局域网传书接收端：把落盘的临时文件包成 content Uri，直接复用
          BookImporter.prepare() 既有导入流水线（AC-9.5：不出现第二条导入逻辑）。
          仅本进程使用（exported=false），接收文件位于 cacheDir/transfer/。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
