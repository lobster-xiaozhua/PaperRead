# PaperRead 发布签名属性模板（复制为 keystore.properties 后填写，该文件已被 .gitignore 排除，绝不入库）
# 生成密钥：./scripts/generate-keystore.sh
# 本地签名：在 local.properties 或 ~/.gradle/gradle.properties 写入以下四项，再 ./gradlew assembleClientRelease
RELEASE_STORE_FILE=/absolute/path/to/paperread-release.jks
RELEASE_STORE_PASSWORD=改成你的密钥库口令
RELEASE_KEY_ALIAS=paperread
RELEASE_KEY_PASSWORD=改成你的密钥口令
